{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "domain",
    "tags",
    "summary",
    "problem",
    "users",
    "goals",
    "non_goals",
    "requirements",
    "stack",
    "test_strategy",
    "security_notes",
    "roadmap"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 24
      }
    },
    "summary": { "type": "string", "minLength": 10, "maxLength": 200 },
    "problem": { "type": "string", "minLength": 40 },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 120 }
    },
    "goals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 160 }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 160 }
    },
    "requirements": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "description", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{1,3}$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 80 },
          "priority": { "enum": ["MUST", "SHOULD", "COULD"] },
          "description": { "type": "string", "minLength": 20 },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 200 }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "test"],
      "properties": {
        "language": { "type": "string", "maxLength": 40 },
        "runtime": { "type": "string", "maxLength": 60 },
        "libraries": { "type": "array", "items": { "type": "string", "maxLength": 60 } },
        "build": { "type": "string", "maxLength": 80 },
        "test": { "type": "string", "maxLength": 80 },
        "lint": { "type": "string", "maxLength": 80 },
        "typecheck": { "type": "string", "maxLength": 80 }
      }
    },
    "test_strategy": { "type": "string", "minLength": 40 },
    "security_notes": { "type": "string", "minLength": 20 },
    "roadmap": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 160 }
    }
  }
}
